@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
    bool Is(params string[] prefixes) => prefixes.Any(p => path.StartsWith(p));
    var onHome = path == "/" || path == "/home";
    string Link(string href, bool active) => active ? "nav-link active" : "nav-link";
}
<header class="site-navbar" id="navbar">
    <div class="container nav-inner">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="ZE home">
            <img src="~/images/ze-nav-logo-3d.png" alt="ZE logo" class="brand-mark" asp-append-version="true" />
        </a>

        <nav class="nav-menu" id="nav-menu" aria-label="Main navigation">
            <a class="@(Link("/", onHome))" href="/#home">Home</a>
            <a class="@(Link("/", false))" href="/#about">About</a>
            <a class="@(Link("/", false))" href="/#services">What We Do</a>
            <a class="@(Link("/", false))" href="/#skills">My Skills</a>
            <a class="@(Is("/projects") ? "nav-link active" : "nav-link")" href="/#projects">Selected Work</a>
            <a class="@(Link("/", false))" href="/#dna">Project DNA</a>
            <a class="@(Is("/contact") ? "nav-link active" : "nav-link")" href="/#contact">Get In Touch</a>
            <a class="@(Link("/", false))" href="/#founders">Meet The Founders</a>
        </nav>

        <div class="nav-actions">
            <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
    <div class="nav-backdrop" id="nav-backdrop"></div>
</header>
